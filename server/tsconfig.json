{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@trao/shared": ["../shared/dist/index.d.ts"]
    },
    "rootDir": "./src",
    `"types":["node"]`
  },
  "include": ["src/**/*"]
}
