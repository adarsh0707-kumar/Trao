# ==============================================================================
# Trao AI Interview Prep Kit - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/trao_interview_prep

# Authentication
JWT_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRES_IN=7d

# Security & Crawling
# Set to 'true' during local testing/batch evaluation to permit crawling local addresses like http://localhost:8099/
ALLOW_LOCAL_URLS=true
CRAWL_TIMEOUT_MS=8000
MAX_CRAWL_PAGES=3

# LLM Provider Options: 'gemini' (recommended free tier) | 'groq' | 'openrouter'
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (Optional free tier at https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter API Key (Optional fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
